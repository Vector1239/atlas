{
  "name": "atlas-local",
  "version": "1.12.7",
  "description": "Your local life assistant, powered by Hermes and Gemma",
  "private": true,
  "type": "module",
  "main": "desktop.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "package": "electron-packager . Atlas --platform=darwin --arch=arm64 --out=release --overwrite --no-asar --app-bundle-id=local.atlas.assistant --icon=assets/Atlas.icns --ignore=release --ignore=tests --ignore=src --ignore=package-lock.json --ignore=render-icon.cjs",
    "prebuild": "node build-info.cjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.9.0",
    "vite": "^8.3.4"
  }
}
